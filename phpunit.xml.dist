<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" failOnWarning="true" failOnRisky="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="offline">
            <directory suffix="Test.php">tests/Offline</directory>
        </testsuite>
        <testsuite name="contract">
            <directory suffix="Test.php">tests/Contract</directory>
        </testsuite>
    </testsuites>
    <source><include><directory suffix=".php">src</directory></include></source>
</phpunit>
