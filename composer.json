{
    "name": "automattic/wistia-php",
    "description": "PHP wrapper for Wistia API",
    "keywords": [
        "wistia",
        "php",
        "client",
        "wrapper",
        "video"
    ],
    "homepage": "http://github.com/Automattic/wistia-php",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Automattic",
            "email": "info@automattic.com",
            "homepage": "https://automattic.com"
        },
        {
            "name": "Nicola Mustone",
            "email": "nicola@automattic.com",
            "homepage": "https://nicolamustone.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Automattic\\Wistia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Automattic\\Wistia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    }
}
